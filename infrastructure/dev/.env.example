# Lute — dev compose env template.
# Copy to infrastructure/dev/.env and adjust before running `make dev-up-clean`.
# Variables without a default in docker-compose.yml are REQUIRED.

# ---------- Required ----------

# JWT signing key. MUST be >= 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-bytes

# Bootstrap admin user, seeded on first startup if no user with this email exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# ---------- Server ----------

SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# Host port mappings (left side of "host:container"). Defaults inlined below.
API_HTTP_PORT=8080
API_GRPC_PORT=50051

# ---------- Auth tuning (optional) ----------

JWT_ISSUER=lute
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# MUST be true in production (HTTPS). false here because dev runs over plain HTTP.
AUTH_COOKIE_SECURE=false

# ---------- gRPC ----------

GRPC_PORT=50051
GRPC_HOST=0.0.0.0

# ---------- WebSocket ----------

WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_CHECK_ORIGIN=false

# ---------- SQLite ----------

SQLITE_PATH=/data/lute.db
SQLITE_BUSY_TIMEOUT=5s

# ---------- Metrics / heartbeat ----------

# How often the snapshot job writes metrics to the DB. Drives chart resolution.
METRICS_SNAPSHOT_INTERVAL=5s
# How often the API pings workers. Should be <= METRICS_SNAPSHOT_INTERVAL.
HEARTBEAT_CHECK_INTERVAL=5s
# Vite build-time: dashboard refetch interval in seconds.
VITE_METRICS_UPDATE_INTERVAL_SECONDS=5

# ---------- Worker binary build args ----------

WORKER_VERSION=0.1.0
BUILD_TIME=unknown
