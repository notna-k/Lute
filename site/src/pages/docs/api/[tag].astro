---
// One page per resource (OpenAPI tag): endpoint index, the object, then every endpoint.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from 'astro:components';
import Endpoint from '../../../components/api/Endpoint.astro';
import { annotatedObject, md, objectSchema, operationsFor, specVersion, tags, type Tag } from '../../../lib/openapi';

export function getStaticPaths() {
	return tags.map((tag) => ({ params: { tag: tag.name }, props: { tag } }));
}

const { tag } = Astro.props as { tag: Tag };
const ops = operationsFor(tag.name);
const object = tag.object ? objectSchema(tag.object) : undefined;
const objectName = tag.object?.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
const base = import.meta.env.BASE_URL;

const headings = [
	...(object ? [{ depth: 2, slug: 'object', text: `The ${objectName} object` }] : []),
	...ops.map((op) => ({ depth: 2, slug: op.id, text: op.summary })),
];
---

<StarlightPage
	frontmatter={{ title: tag.title, description: tag.description.split('\n')[0], editUrl: false }}
	headings={headings}
>
	<div class="not-content intro">
		<div class="prose" set:html={md(tag.description)} />
		<div class="meta">
			<span>base <b>/api/public/v1</b></span>
			<span>auth <b>API key</b></span>
			<span>format <b>JSON</b></span>
		</div>
		<div class="index">
			<div class="lute-eyebrow">Endpoints</div>
			{
				ops.map((op) => (
					<a href={`#${op.id}`}>
						<span class={`m lute-m-${op.method.toLowerCase()}`}>{op.method}</span>
						<span class="p">{op.path}</span>
						<span class="s">{op.summary}</span>
					</a>
				))
			}
		</div>
	</div>

	{
		object && (
			<section class="not-content object" aria-labelledby="object">
				<h2 id="object">The {objectName} object</h2>
				<p>Endpoints on this page return {objectName}s in this shape. Fields with no value are left out.</p>
				<div class="block">
					<Code code={annotatedObject(object)} lang="jsonc" theme="github-dark-dimmed" />
				</div>
			</section>
		)
	}

	{ops.map((op) => <Endpoint op={op} />)}

	<div class="not-content foot">
		<a href={`${base}openapi.yaml`}>Generated from openapi.yaml</a>
		<span>API v{specVersion}</span>
	</div>
</StarlightPage>

<style>
	.intro .prose {
		color: var(--sl-color-gray-2);
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.intro .prose :global(p + p) {
		margin-top: 0.75rem;
	}
	.intro :global(code) {
		font-family: var(--sl-font-mono);
		font-size: 0.85em;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		padding: 0.05rem 0.3rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin-top: 1rem;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
	}
	.meta b {
		font-weight: 400;
		color: var(--sl-color-white);
	}
	.index {
		margin-top: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.index .lute-eyebrow {
		padding: 0.55rem 1rem;
		background: var(--sl-color-gray-6);
	}
	.index a {
		display: grid;
		grid-template-columns: 4.5rem minmax(12rem, 18rem) 1fr;
		gap: 1rem;
		align-items: baseline;
		padding: 0.65rem 1rem;
		border-top: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-size: 0.9rem;
	}
	.index a:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.m,
	.p {
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
	}
	.p {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.index a {
			grid-template-columns: 4rem 1fr;
		}
		.index .s {
			display: none;
		}
	}
	.object {
		margin-top: 3rem;
	}
	.object h2 {
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
		margin: 0 0 0.5rem;
		scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
	}
	.object p {
		color: var(--sl-color-gray-2);
		margin: 0 0 1rem;
	}
	.block {
		background: var(--lute-code-bg);
		border: 1px solid var(--lute-code-border);
	}
	.block :global(pre) {
		margin: 0;
		padding: 1rem 1.1rem;
		background: transparent !important;
		font-size: 0.8rem;
		line-height: 1.75;
		overflow-x: auto;
	}
	.foot {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 3rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}
</style>
