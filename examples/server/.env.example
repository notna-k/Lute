# Copy to .env and fill in.

# Signs panel sessions, at least 32 bytes:  openssl rand -base64 48
JWT_SECRET=
# The first admin, created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Goes into a connection URL, so stick to letters and digits:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Where people open the panel, scheme included.
LUTE_URL=https://lute.example.com
# Serving the panel over plain HTTP? Then the session cookie cannot be Secure.
# AUTH_COOKIE_SECURE=false

# Directory of job definition YAML, usually a checkout of your jobs repository.
JOB_DEFS_PATH=./jobdefs
# gRPC address workers dial, shown in the panel's "Add worker" command.
# Defaults to the panel's host name and port 50051.
# WORKER_GRPC_ADDR=lute.example.com:50051
