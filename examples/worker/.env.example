# Copy to .env and fill in.

# Core's gRPC address, host:port.
LUTE_SERVER=lute.example.com:50051
# A registration token from the panel: Workers → Add worker.
LUTE_TOKEN=
# Set to 1 when a TLS-terminating proxy sits in front of core's gRPC port.
LUTE_TLS=0

# Unique across Lute; defaults to the machine's host name.
# LUTE_NAME=build-01
LUTE_QUEUES=default
# LUTE_LABELS=region=eu,arch=amd64
