# Build context is the repo root (infrastructure/dev/docker-compose.yml: context: ../..).
# Docker only reads THIS file — not api/.dockerignore or ui/.dockerignore.

.git
.gitignore

# Host install; image runs `npm ci` — copying node_modules is slow and huge.
ui/node_modules
ui/dist

# Misplaced dependency dir at repo root
node_modules

worker/bin

# NOTE: api/internal/ui/web is intentionally NOT ignored — it holds the committed
# placeholder index.html; api/Dockerfile replaces it with the built panel.

.env
.env.*
!.env.example

.idea
.vscode
.cursor
.DS_Store
*.log
api/e2e/_artifacts
