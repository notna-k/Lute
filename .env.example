# Lute dev stack — copy to `.env` at the repo root, then `make dev-up`.
#
#   cp .env.example .env
#
# The Makefile passes this file to compose with `--env-file $(CURDIR)/.env`,
# so it must live at the repo root, not in infrastructure/dev/.
#
# Only JWT_SECRET, ADMIN_EMAIL and ADMIN_PASSWORD have no default — the stack
# will not start without them. Everything else is shown at its default value
# and can be deleted from your copy.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs access/refresh tokens. Must be at least 32 bytes or Core refuses to
# start. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Seeded on first startup, then left alone. Use a real password — this account
# owns the panel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
# ADMIN_PORT and API_HTTP_PORT must differ — they are two separate containers
# and the second one to bind a shared port fails to start.

# Admin panel (nginx serving the SPA, proxying /api to core). Browse here.
ADMIN_PORT=8090

# Core's HTTP API, exposed directly for programmatic access. The panel does
# not need this — it reaches core over the compose network.
API_HTTP_PORT=8080

# gRPC endpoint workers connect to.
API_GRPC_PORT=50051

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Durable domain state and the job queue. Not published to the host; reachable
# from the other containers as `postgres:5432`.

POSTGRES_USER=lute
POSTGRES_PASSWORD=lute
POSTGRES_DB=lute

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
# Ports here are container-internal; map them with the *_PORT vars above.

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# `release` or `debug`. debug logs every route and request.
GIN_MODE=release

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

JWT_ISSUER=lute
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Set to true once you terminate TLS in front of the panel — the refresh
# cookie then carries the Secure flag and will not survive plain HTTP.
AUTH_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------

WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024

# Leave false for local work; enable to reject cross-origin upgrades.
WS_CHECK_ORIGIN=false

# ---------------------------------------------------------------------------
# Intervals
# ---------------------------------------------------------------------------

METRICS_SNAPSHOT_INTERVAL=5s
HEARTBEAT_CHECK_INTERVAL=5s

# How often the panel refreshes worker metrics, in seconds. Baked into the SPA
# at build time — changing it requires `make dev-build`.
VITE_METRICS_UPDATE_INTERVAL_SECONDS=5

# ---------------------------------------------------------------------------
# Build metadata
# ---------------------------------------------------------------------------
# Stamped into worker binaries. The Makefile overrides these; they matter only
# if you invoke docker compose directly.

WORKER_VERSION=0.1.0
BUILD_TIME=unknown
