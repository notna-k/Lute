# Copy to `.env` at the repo root (the Makefile passes --env-file <root>/.env), then `make dev-up`.
# Only JWT_SECRET, ADMIN_EMAIL and ADMIN_PASSWORD lack defaults; the rest are shown at theirs.

# --- Required ---

# Signs access/refresh tokens; must be >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# Bootstrap admin, seeded on first startup only. This account owns the panel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Published ports (ADMIN_PORT and API_HTTP_PORT must differ, or the second container fails to bind) ---

# Admin panel — browse here.
ADMIN_PORT=8090

# Core's HTTP API, exposed for programmatic access; the panel reaches core over the compose network.
API_HTTP_PORT=8080

# gRPC endpoint workers connect to.
API_GRPC_PORT=50051

# --- Postgres (not published; reachable from other containers as postgres:5432) ---

POSTGRES_USER=lute
POSTGRES_PASSWORD=lute
POSTGRES_DB=lute

# --- Core server (ports here are container-internal; map them with the *_PORT vars above) ---

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# `release` or `debug`; debug logs every route and request.
GIN_MODE=release

# --- Auth ---

JWT_ISSUER=lute
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Set true once TLS terminates in front of the panel — the refresh cookie then requires HTTPS.
AUTH_COOKIE_SECURE=false

# --- WebSocket ---

WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024

# Enable to reject cross-origin upgrades; leave false for local work.
WS_CHECK_ORIGIN=false

# --- Intervals ---

METRICS_SNAPSHOT_INTERVAL=5s
HEARTBEAT_CHECK_INTERVAL=5s

# Panel metrics refresh, in seconds. Baked into the SPA at build time — changing it needs `make dev-build`.
VITE_METRICS_UPDATE_INTERVAL_SECONDS=5

# --- Build metadata (the Makefile overrides these; they matter only for direct docker compose calls) ---

WORKER_VERSION=0.1.0
BUILD_TIME=unknown

CORS_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:8080,http://localhost:5173